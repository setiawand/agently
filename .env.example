OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:32b

GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=

N8N_URL=http://localhost:5678
N8N_API_KEY=

# LLM_PROVIDER=ollama (default, on-prem) atau openrouter (cloud: data dikirim ke pihak ketiga!)
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# AGENTLY_TRACE=1 -> tampilkan tiap langkah model di stderr (lokal)
AGENTLY_TRACE=
LLM_THINKING=   # off = matikan thinking (lebih cepat di model lokal)

# Tokopedia (TikTok Shop Partner Center, custom app untuk toko sendiri)
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_SHOP_CIPHER=        # kosong = otomatis jika hanya 1 toko
TTS_TOKEN_FILE=.tts_tokens.json
# TTS_ACCESS_TOKEN / TTS_REFRESH_TOKEN opsional; cara biasa: python -m tokopedia.auth <auth_code>
